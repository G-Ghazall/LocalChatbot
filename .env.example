# Set these as environment variables before launching; this file is not loaded automatically.
LOCALCHAT_CHAT_MODEL=llama3.2:latest
LOCALCHAT_EMBED_MODEL=nomic-embed-text
LOCALCHAT_OLLAMA_URL=http://127.0.0.1:11434
LOCALCHAT_NUM_CTX=8192
LOCALCHAT_MAX_CONTEXT=16000
LOCALCHAT_FOCUSED_K=6
LOCALCHAT_TOPIC_K=12
LOCALCHAT_COMPARISON_K=5
LOCALCHAT_MAX_SUMMARY_PARTS=30
LOCALCHAT_HISTORY_TURNS=6
LOCALCHAT_VERIFY=false
LOCALCHAT_DEBUG=false
